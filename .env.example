# Copy to .env and replace every placeholder. Do not commit .env.
POSTGRES_PASSWORD=replace_with_admin_password
DB_MIGRATION_PASSWORD=replace_with_migration_password
DB_APP_PASSWORD=replace_with_application_password
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
# Base64 of 32 random bytes, required by Integration when encrypting credentials.
SMARTOMNI_ENCRYPTION_AES_KEY=replace_with_base64_encoded_32_byte_key
# Shared token used only between the Java Quartz worker and internal job endpoints.
INTERNAL_JOB_TOKEN=replace_with_a_random_secret_at_least_32_characters_long
# Python FastAPI runs separately; Compose uses host.docker.internal:8000 by default.
# PYTHON_AI_BASE_URL=http://host.docker.internal:8000
