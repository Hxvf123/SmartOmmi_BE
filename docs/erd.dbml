// SmartOmni schema after Flyway V1-V8. SQL migrations are authoritative.
// PostgreSQL timestamptz, numeric precision, defaults and nullable columns
// mirror migration DDL. DBML cannot encode RLS, triggers or CHECK clauses.
// Every tenant-owned business table uses FORCE ROW LEVEL SECURITY.

Enum user_role {
  super_admin
  admin
  manager
}

Enum user_status {
  active
  disabled
}

Enum tenant_status {
  active
  locked
}

Enum platform_type {
  shopee
  tiktok_shop
  storefront
}

Enum connection_status {
  connected
  error
  disconnected
}

Enum product_status {
  active
  hidden
}

Enum order_status {
  pending
  to_ship
  shipped
  delivering
  completed
  cancelled
  returned
}

Enum order_change_source {
  manager
  marketplace_webhook
  system
}

Enum order_source {
  webhook
  polling
  manual
}

Enum return_trigger_type {
  refused_delivery
  customer_request
}

Enum refund_status {
  requested
  approved
  rejected
  completed
}

Enum inspection_result_type {
  pending
  matched
  damaged
  swapped
  missing_items
}

Enum dispute_status_type {
  none
  filed
  approved
  denied
}

Enum outbox_status {
  pending
  sent
  failed
}

Enum promotion_scope {
  all
  category
  sku
}

Enum model_type {
  demand_forecasting
  recommendation
}

Enum model_status {
  training
  active
  rolled_back
}

Enum interaction_type {
  view
  cart
  purchase
}

Enum ticket_status {
  open
  in_progress
  resolved
}

Enum security_event_type {
  rls_violation
  cross_tenant_test
  login_failure
  brute_force_lock
}

Enum sync_scope {
  tenant
  product
}

Enum billing_interval {
  monthly
  yearly
}

Enum invoice_status {
  pending
  paid
  overdue
  cancelled
}

Enum payment_status {
  pending
  success
  failed
}

// ---------- Tenant and subscription ----------

Table tenants {
  id bigint [pk, increment]
  name varchar
  subdomain varchar [not null]
  status tenant_status [default: 'active']
  plan_id bigint [ref: > subscription_plans.id]
  billing_cycle billing_interval [default: 'monthly']
  next_billing_date date
  auto_renew boolean [default: true]
  locked_reason varchar
  locked_by bigint [ref: > users.id]
  locked_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz

  indexes {
    subdomain [unique]
  }

  Note: 'Mọi bảng nghiệp vụ có tenant_id đều bật Row-Level Security (RLS) tham chiếu tới bảng này.'
}

Table subscription_plans {
  id bigint [pk, increment]
  name varchar
  price numeric(14,2)
  billing_interval billing_interval [default: 'monthly']
  max_skus integer
  max_marketplace_connections integer
  storage_limit_mb integer
  updated_by bigint
  created_at timestamptz [default: `now()`]
  updated_at timestamptz

  indexes {
    name [unique]
  }

  Note: 'Định nghĩa gói dịch vụ - Super Admin quản lý. Dữ liệu GLOBAL, không thuộc riêng tenant nào.'
}

Table plan_feature_flags {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  plan_id bigint [ref: > subscription_plans.id]
  feature_key varchar
  enabled boolean [default: false]

  indexes {
    (plan_id, feature_key) [unique]
  }

  Note: 'Feature flag chi tiết theo từng gói. Dữ liệu GLOBAL.'
}

Table tenant_subscription_history {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  old_plan_id bigint [ref: > subscription_plans.id]
  new_plan_id bigint [ref: > subscription_plans.id]
  changed_by bigint [ref: > users.id]
  changed_at timestamptz [default: `now()`]

  Note: 'Lịch sử nâng/hạ cấp gói dịch vụ (Luồng 11).'
}

Table resource_usage {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  sku_count integer [default: 0]
  marketplace_connections_count integer [default: 0]
  storage_used_mb integer [default: 0]
  last_calculated_at timestamptz

  indexes {
    tenant_id [unique]
  }

  Note: 'Theo dõi mức dùng tài nguyên so với giới hạn gói - dùng để chặn Downgrade (Luồng 11). Quan hệ 1-1 với tenants.'
}

// ---------- Billing ----------

Table tenant_invoices {
  updated_at timestamptz
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  plan_id bigint [ref: > subscription_plans.id]
  billing_period_start date
  billing_period_end date
  amount numeric(14,2)
  status invoice_status [default: 'pending']
  due_date date
  created_at timestamptz [default: `now()`]

  Note: 'Hóa đơn theo từng chu kỳ billing của tenant.'
}

Table subscription_payments {
  updated_at timestamptz
  id bigint [pk, increment]
  invoice_id bigint [ref: > tenant_invoices.id]
  tenant_id bigint [not null, ref: > tenants.id]
  payment_method varchar
  gateway_transaction_id varchar
  amount numeric(14,2)
  signature_valid boolean
  is_anomaly boolean [default: false]
  confirmed_by bigint [ref: > users.id]
  status payment_status [default: 'pending']
  paid_at timestamptz
  created_at timestamptz [default: `now()`]

  indexes {
    gateway_transaction_id [unique]
  }

  Note: 'Giao dịch thanh toán NÂNG CẤP GÓI DỊCH VỤ. KHÔNG dùng cho đơn hàng khách mua.'
}

// ---------- Staff authentication ----------

Table users {
  id bigint [pk, increment]
  tenant_id bigint [ref: > tenants.id]
  email varchar [not null]
  password_hash varchar [not null]
  full_name varchar
  role user_role [not null]
  status user_status [default: 'active']
  failed_login_attempts integer [default: 0]
  locked_until timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz

  indexes {
    email [unique]
    tenant_id [type: btree]
  }

  Note: 'JWT sinh ra từ bảng này chứa user_id, role, tenant_id.'
}

Table password_reset_tokens {
  updated_at timestamptz
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  token varchar [not null]
  expires_at timestamptz [not null]
  used boolean [default: false]
  created_at timestamptz [default: `now()`]

  indexes {
    token [unique]
    user_id [type: btree]
  }

  Note: 'Quên mật khẩu / đặt lại mật khẩu. Không có tenant_id trực tiếp - suy ra qua user_id.'
}

Table auth_sessions {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  jwt_id varchar [not null]
  issued_at timestamptz
  expires_at timestamptz
  revoked boolean [default: false]

  indexes {
    jwt_id [unique]
    user_id [type: btree]
  }

  Note: 'Theo dõi/thu hồi JWT khi đăng xuất. Không có tenant_id trực tiếp - suy ra qua user_id.'
}

// ---------- Marketplace connections ----------

Table marketplace_connections {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  platform platform_type [not null]
  shop_id varchar
  shop_name varchar
  app_key varchar
  app_secret_encrypted varchar
  webhook_url varchar
  status connection_status [default: 'connected']
  auto_import_products boolean [default: false]
  connected_at timestamptz [default: `now()`]

  indexes {
    (tenant_id, platform, shop_id) [unique]
    (tenant_id, id) [unique]
  }

  Note: 'Một tenant có thể có nhiều shop trên cùng 1 sàn (VD: Mall + Outlet).'
}

// ---------- Catalog ----------

Table products {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  name varchar [not null]
  description text
  status product_status [default: 'active']
  created_by bigint [ref: > users.id]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz

  indexes {
    tenant_id [type: btree]
  }
}

Table product_skus {
  updated_at timestamptz
  id bigint [pk, increment]
  product_id bigint [ref: > products.id]
  tenant_id bigint [not null, ref: > tenants.id]
  sku_code varchar [not null]
  variant_name varchar
  base_price numeric(14,2)
  created_at timestamptz [default: `now()`]

  indexes {
    (tenant_id, sku_code) [unique]
    product_id [type: btree]
  }
}

Table product_images {
  updated_at timestamptz
  id bigint [pk, increment]
  product_id bigint [ref: > products.id]
  sku_id bigint [ref: > product_skus.id]
  tenant_id bigint [not null, ref: > tenants.id]
  url varchar [not null]
  sort_order integer [default: 0]
  created_at timestamptz [default: `now()`]

  Note: 'Lưu trên Cloud Storage theo prefix {tenant_id}/products/...'
}

Table product_marketplace_links {
  updated_at timestamptz
  id bigint [pk, increment]
  sku_id bigint [ref: > product_skus.id]
  connection_id bigint [ref: > marketplace_connections.id]
  tenant_id bigint [not null, ref: > tenants.id]
  platform platform_type [not null]
  platform_item_id varchar
  platform_product_url varchar
  platform_price numeric(14,2)
  last_synced_at timestamptz
  created_at timestamptz [default: `now()`]

  indexes {
    (sku_id, connection_id) [unique]
  }

  Note: 'Gắn link sản phẩm sàn TMĐT. Dùng connection_id thay vì platform để hỗ trợ nhiều shop/sàn.'
}

Table price_sync_configs {
  updated_at timestamptz
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  scope sync_scope [not null]
  sku_id bigint [ref: > product_skus.id]
  platform platform_type
  sync_enabled boolean [default: false]
  sync_frequency_minutes integer
  created_at timestamptz [default: `now()`]
}

Table price_sync_history {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  sync_config_id bigint [ref: > price_sync_configs.id]
  sku_id bigint [ref: > product_skus.id]
  tenant_id bigint [not null, ref: > tenants.id]
  platform platform_type
  old_price numeric(14,2)
  new_price numeric(14,2)
  is_anomaly boolean [default: false]
  confirmed_by bigint [ref: > users.id]
  changed_at timestamptz [default: `now()`]

  Note: 'Lịch sử & cảnh báo bất thường khi tự động fetch giá.'
}

// ---------- Inventory ----------

Table inventory {
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  sku_id bigint [ref: > product_skus.id]
  tenant_id bigint [not null, ref: > tenants.id]
  quantity_on_hand integer [default: 0]
  reserved_quantity integer [default: 0]
  version integer [default: 0]
  updated_at timestamptz

  indexes {
    sku_id [unique]
  }

  Note: 'Giả định 1 kho duy nhất mỗi tenant (quan hệ 1-1 với product_skus).'
}

Table inventory_outbox_events {
  updated_at timestamptz
  id bigint [pk, increment]
  sku_id bigint [ref: > product_skus.id]
  tenant_id bigint [not null, ref: > tenants.id]
  platform platform_type
  quantity integer
  status outbox_status [default: 'pending']
  retry_count integer [default: 0]
  created_at timestamptz [default: `now()`]
  processed_at timestamptz

  Note: 'Đồng bộ tồn kho ngược lên sàn TMĐT qua Outbox Pattern (Luồng 4).'
}

// ---------- Orders ----------

Table orders {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  connection_id bigint [ref: > marketplace_connections.id]
  platform platform_type [not null]
  platform_order_id varchar
  status order_status [default: 'pending']
  completed_at timestamptz
  eligible_for_points_at timestamptz
  sla_deadline timestamptz
  shipping_method varchar
  tracking_number varchar
  courier_scanned_at timestamptz
  customer_name varchar
  customer_phone varchar
  shipping_address text
  total_amount numeric(14,2)
  source order_source
  created_at timestamptz [default: `now()`]
  updated_at timestamptz

  indexes {
    (tenant_id, connection_id, platform_order_id) [unique]
    (tenant_id, id) [unique]
    (tenant_id, status) [type: btree]
  }

  Note: 'source=manual dùng cho đơn offline/in-store (Luồng 15), độc lập hoàn toàn với vòng đời marketplace.'
}

Table order_items {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  order_id bigint [ref: > orders.id]
  tenant_id bigint [not null, ref: > tenants.id]
  sku_id bigint [ref: > product_skus.id]
  quantity integer
  unit_price numeric(14,2)

  indexes {
    order_id [type: btree]
  }
}

Table order_status_history {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  order_id bigint [ref: > orders.id]
  tenant_id bigint [not null, ref: > tenants.id]
  status order_status
  source order_change_source [not null]
  changed_by bigint [ref: > users.id]
  changed_at timestamptz [default: `now()`]
}

Table returns_refunds {
  updated_at timestamptz
  id bigint [pk, increment]
  order_id bigint [ref: > orders.id]
  tenant_id bigint [not null, ref: > tenants.id]
  trigger_type return_trigger_type [not null]
  return_tracking_number varchar
  reason text
  status refund_status [default: 'requested']
  reviewed_by bigint [ref: > users.id]
  received_at timestamptz
  video_evidence_url varchar
  inspection_result inspection_result_type [default: 'pending']
  restocked boolean [default: false]
  dispute_status dispute_status_type [default: 'none']
  compensation_amount numeric(14,2)
  created_at timestamptz [default: `now()`]

  Note: 'SmartOmni KHÔNG xử lý hoàn tiền cho khách - chỉ ghi nhận trạng thái + bằng chứng, tiền hoàn do sàn tự xử lý độc lập.'
}

Table webhook_events_log {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  platform platform_type
  event_id varchar
  event_type varchar
  order_id bigint [ref: > orders.id]
  signature_valid boolean
  raw_payload text
  queued boolean [default: false]
  processed_at timestamptz
  received_at timestamptz [default: `now()`]

  indexes {
    (tenant_id, platform, event_id) [unique]
  }

  Note: 'Log toàn bộ Webhook đến (cả tạo đơn lẫn đổi trạng thái), xác thực HMAC/SHA256.'
}

Table seller_wallet_ledger {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  order_id bigint [ref: > orders.id]
  gross_amount numeric(14,2)
  platform_fee numeric(14,2)
  freeship_fee numeric(14,2)
  net_payout numeric(14,2)
  recorded_at timestamptz [default: `now()`]

  indexes {
    order_id [unique]
  }

  Note: 'Ghi nhận payout tự động khi order.status = completed (Luồng 3b bước 3b.7a). Độc lập hoàn toàn với subscription_payments.'
}

// ---------- Promotions and AI ----------

Table promotion_events {
  updated_at timestamptz
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  name varchar
  discount_percent numeric(5,2)
  start_date date
  end_date date
  applies_to promotion_scope [default: 'all']
  created_by bigint [ref: > users.id]
  created_at timestamptz [default: `now()`]

  Note: 'Biến ngoại sinh h(t) khai báo cho mô hình Prophet.'
}

Table promotion_items {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  promotion_id bigint [ref: > promotion_events.id]
  sku_id bigint [ref: > product_skus.id]

  indexes {
    (promotion_id, sku_id) [unique]
    promotion_id [type: btree]
  }

  Note: 'Map 1 chương trình khuyến mãi với N sản phẩm. Không có tenant_id trực tiếp - suy ra qua promotion_id.'
}

Table ai_model_versions {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  model_type model_type [not null]
  version_number varchar
  rmse numeric(10,4)
  status model_status [default: 'training']
  trained_at timestamptz [default: `now()`]

  Note: 'Registry tenant_id -> model version, phục vụ rollback và audit.'
}

Table demand_forecasts {
  updated_at timestamptz
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  sku_id bigint [ref: > product_skus.id]
  model_version_id bigint [ref: > ai_model_versions.id]
  forecast_date date
  predicted_quantity integer
  recommended_reorder_qty integer
  created_at timestamptz [default: `now()`]

  indexes {
    (tenant_id, sku_id, forecast_date, model_version_id) [unique]
  }

  Note: 'Kết quả Demand Forecasting - là điểm KẾT THÚC của Luồng 6 (Manager chỉ xem, không có module PO trong hệ thống).'
}

Table sales_outlier_exclusions {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  sku_id bigint [ref: > product_skus.id]
  order_id bigint [ref: > orders.id]
  reason varchar
  excluded_at timestamptz [default: `now()`]

  indexes {
    (sku_id, order_id) [unique]
  }

  Note: 'Ghi nhận dữ liệu lịch sử bị loại trước khi train Prophet (Luồng 6 bước 6.3) - phục vụ audit.'
}

Table user_item_interactions {
  updated_at timestamptz
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  customer_identifier varchar
  sku_id bigint [ref: > product_skus.id]
  interaction_type interaction_type [not null]
  weight integer
  created_at timestamptz [default: `now()`]

  Note: 'User-Item Matrix cho Recommendation Engine (Luồng 12).'
}

Table product_recommendations_cache {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  source_sku_id bigint [ref: > product_skus.id]
  recommended_sku_id bigint [ref: > product_skus.id]
  similarity_score numeric(6,4)
  computed_at timestamptz [default: `now()`]

  indexes {
    (tenant_id, source_sku_id, recommended_sku_id) [unique]
  }

  Note: 'Top-3 gợi ý theo Cosine Similarity.'
}

Table redirect_click_events {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  sku_id bigint [ref: > product_skus.id]
  platform platform_type
  clicked_at timestamptz [default: `now()`]

  Note: 'Ghi nhận click "Mua ngay" trên storefront (catalog-only, redirect ra sàn) để tính CTR - Luồng 2.'
}

// ---------- Support and security ----------

Table support_tickets {
  updated_at timestamptz
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  created_by bigint [ref: > users.id]
  assigned_to bigint [ref: > users.id]
  subject varchar
  description text
  status ticket_status [default: 'open']
  created_at timestamptz [default: `now()`]
  resolved_at timestamptz
}

Table security_audit_logs {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  tenant_id bigint [ref: > tenants.id]
  event_type security_event_type [not null]
  details text
  session_tenant_id bigint
  detected_at timestamptz [default: `now()`]

  Note: 'Log RLS violation & kết quả kiểm thử chéo Tenant.'
}

Table system_metric_alerts {
  updated_at timestamptz
  created_at timestamptz [default: `now()`]
  id bigint [pk, increment]
  metric_name varchar
  threshold_value numeric(14,4)
  current_value numeric(14,4)
  triggered_at timestamptz [default: `now()`]
  resolved boolean [default: false]

  Note: 'Cảnh báo hiệu năng/log hệ thống qua Prometheus/Grafana/ELK. Không gắn tenant - chỉ super_admin xem.'
}

// ---------- Customer loyalty (V7-V8) ----------

// First eligible customer to claim a completed order receives its points.
// V8 awards floor(total_amount / 1000) points; tier uses cumulative net earned points.
// Rewards use a staff-defined threshold and do not consume points.

Table customer_accounts {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  email varchar [not null]
  password_hash varchar [not null]
  display_name varchar
  status varchar [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    (tenant_id, id) [unique]
    (tenant_id, `lower(email)`) [unique]
  }
}

Table loyalty_claims {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  order_id bigint [not null]
  customer_id bigint [not null]
  points_awarded bigint [not null]
  eligible_amount_vnd decimal(14,2) [note: 'Snapshot of order total at claim']
  claimed_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, id) [unique]
    (tenant_id, order_id) [unique]
    (tenant_id, customer_id, claimed_at) [type: btree]
  }
}

Table loyalty_point_accounts {
  tenant_id bigint [not null]
  customer_id bigint [not null]
  total_points bigint [not null, default: 0]
  tier varchar [note: 'Generated: standard <500; silver >=500; platinum >=1000; diamond >=1500']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, customer_id) [pk]
  }
}

Table loyalty_voucher_codes {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  connection_id bigint [not null]
  code varchar [not null]
  points_cost bigint [not null]
  status varchar [not null, default: 'available']
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Legacy V7 voucher stock; application inserts disabled in V8.'

  indexes {
    (tenant_id, id) [unique]
    (tenant_id, connection_id, code) [unique]
    (tenant_id, connection_id, points_cost, expires_at) [type: btree, note: 'WHERE status = available']
  }
}

Table loyalty_voucher_issuances {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  customer_id bigint [not null]
  voucher_code_id bigint [not null, unique]
  points_spent bigint [not null]
  issued_at timestamptz [not null, default: `now()`]
  Note: 'Legacy V7 point-spending issuance; application inserts disabled in V8.'

  indexes {
    (tenant_id, id) [unique]
    (tenant_id, customer_id, issued_at) [type: btree]
  }
}

Table loyalty_point_ledger {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  customer_id bigint [not null]
  claim_id bigint
  voucher_issuance_id bigint
  reason varchar [not null]
  points_delta bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'New V8 entries are earn/reverse only; historical redeem rows remain.'

  indexes {
    (tenant_id, claim_id, reason) [unique, note: 'WHERE claim_id IS NOT NULL']
    (tenant_id, voucher_issuance_id) [unique, note: 'WHERE voucher_issuance_id IS NOT NULL']
    (tenant_id, customer_id, created_at) [type: btree]
  }
}

Table loyalty_reward_campaigns {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  connection_id bigint [not null]
  created_by bigint [not null, ref: > users.id]
  name varchar [not null]
  discount_percent decimal(5,2) [not null]
  required_points bigint [not null]
  quantity integer [not null]
  reserved_count integer [not null, default: 0]
  provisioning_mode varchar [not null, note: 'api or import']
  status varchar [not null, default: 'draft']
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    (tenant_id, id) [unique]
    (tenant_id, required_points, ends_at) [type: btree, note: 'WHERE status = active']
  }
}

Table loyalty_reward_requests {
  id bigint [pk, increment]
  tenant_id bigint [not null, ref: > tenants.id]
  campaign_id bigint [not null]
  customer_id bigint [not null]
  request_key uuid [not null, default: `gen_random_uuid()`]
  status varchar [not null, default: 'pending', note: 'pending, issued, failed']
  code varchar
  external_voucher_id varchar
  failure_reason text
  requested_at timestamptz [not null, default: `now()`]
  issued_at timestamptz
  updated_at timestamptz

  indexes {
    (tenant_id, id) [unique]
    request_key [unique]
    (tenant_id, campaign_id, customer_id) [unique, note: 'WHERE status IN (pending, issued)']
    requested_at [type: btree, note: 'WHERE status = pending']
  }
}

// Composite tenant-aware foreign keys added in V7.
Ref: loyalty_claims.(tenant_id, order_id) > orders.(tenant_id, id)
Ref: loyalty_claims.(tenant_id, customer_id) > customer_accounts.(tenant_id, id)
Ref: loyalty_point_accounts.(tenant_id, customer_id) > customer_accounts.(tenant_id, id)
Ref: loyalty_voucher_codes.(tenant_id, connection_id) > marketplace_connections.(tenant_id, id)
Ref: loyalty_voucher_issuances.(tenant_id, customer_id) > customer_accounts.(tenant_id, id)
Ref: loyalty_voucher_issuances.(tenant_id, voucher_code_id) > loyalty_voucher_codes.(tenant_id, id)
Ref: loyalty_point_ledger.(tenant_id, customer_id) > customer_accounts.(tenant_id, id)
Ref: loyalty_point_ledger.(tenant_id, claim_id) > loyalty_claims.(tenant_id, id)
Ref: loyalty_point_ledger.(tenant_id, voucher_issuance_id) > loyalty_voucher_issuances.(tenant_id, id)
Ref: loyalty_reward_campaigns.(tenant_id, connection_id) > marketplace_connections.(tenant_id, id)
Ref: loyalty_reward_requests.(tenant_id, campaign_id) > loyalty_reward_campaigns.(tenant_id, id)
Ref: loyalty_reward_requests.(tenant_id, customer_id) > customer_accounts.(tenant_id, id)
